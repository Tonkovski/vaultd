# Payload staging. Library contents are never versioned; they move to the NAS later.
/vault/

# Per-vault metadata feed caches (refreshable via sokoban dbsync); never versioned.
/db/

# Public dropzone: raw inputs awaiting a keeper; never versioned.
/dropzone/

# Machine-local config that points each library keeper at its library's location.
*.local.toml

# Python / uv
.venv/
.uv-cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Scratch
/tmp/
/.tmp/
*.bak

# Agent / editor local state
.agents/
.claude/settings.local.json
