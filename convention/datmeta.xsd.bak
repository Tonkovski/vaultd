<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://tonkovski.github.io/vaultd/datmeta"
           xmlns="http://tonkovski.github.io/vaultd/datmeta"
           elementFormDefault="qualified">

  <xs:simpleType name="CrcType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-F]{8}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Md5Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{32}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Sha1Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{40}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="datafile">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="comment"   type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="name"        type="xs:string" use="required"/>
            <xs:attribute name="version"     type="xs:string" use="required"/>
            <xs:attribute name="author"      type="xs:string" use="required"/>
            <xs:attribute name="description" type="xs:string"/>
            <xs:attribute name="category"    type="xs:string"/>
            <xs:attribute name="date"        type="xs:string"/>
            <xs:attribute name="email"       type="xs:string"/>
            <xs:attribute name="homepage"    type="xs:anyURI">
              <xs:annotation>
                <xs:documentation>
                  Human-readable project page.
                </xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="url"              type="xs:anyURI">
              <xs:annotation>
                <xs:documentation>
                  Update endpoint for this dat file.
                </xs:documentation>
              </xs:annotation>
            </xs:attribute>
            <xs:attribute name="compressAtIngest" type="xs:boolean" default="false">
              <xs:annotation>
                <xs:documentation>
                  Hint to ingest scripts that stored files should be compressed.
                </xs:documentation>
              </xs:annotation>
            </xs:attribute>
          </xs:complexType>
        </xs:element>

        <xs:element name="entities" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="entity" minOccurs="1" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>
                    A self-contained distributed title. Physical media and digital
                    distribution units share the same model.
                  </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="urls" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Links to this entity. Intended for official sources and third-party tracking databases.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="url" type="xs:anyURI" minOccurs="1" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="comment" type="xs:string" minOccurs="0"/>
                    <xs:element name="releases" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="release" minOccurs="1" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="fs" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>
                                      Structured filesystem of this release.
                                    </xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="dir" minOccurs="0" maxOccurs="unbounded">
                                        <xs:annotation>
                                          <xs:documentation>
                                            Declares an empty directory that must be preserved in the structure.
                                          </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                          <xs:attribute name="path" type="xs:string" use="required"/>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element name="fileshared" minOccurs="0" maxOccurs="unbounded">
                                        <xs:annotation>
                                          <xs:documentation>
                                            Shared file with the same hashes across every copy of this release. All three hashes required.
                                          </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                          <xs:attribute name="path" type="xs:string"       use="required"/>
                                          <xs:attribute name="size" type="xs:unsignedLong" use="required"/>
                                          <xs:attribute name="crc"  type="CrcType"         use="required"/>
                                          <xs:attribute name="md5"  type="Md5Type"         use="required"/>
                                          <xs:attribute name="sha1" type="Sha1Type"        use="required"/>
                                        </xs:complexType>
                                      </xs:element>
                                      <xs:element name="fileinstance" minOccurs="0" maxOccurs="unbounded">
                                        <xs:annotation>
                                          <xs:documentation>
                                            Per-copy unique file.
                                          </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                          <xs:attribute name="path"     type="xs:string"      use="required"/>
                                          <xs:attribute name="size"     type="xs:unsignedLong"/>
                                          <xs:attribute name="required" type="xs:boolean"     default="false">
                                            <xs:annotation>
                                              <xs:documentation>
                                                Indicate at least one matching file must be present for the release to be considered complete.
                                              </xs:documentation>
                                            </xs:annotation>
                                          </xs:attribute>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="pix" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>
                                      Visual records derived from physical objects.
                                    </xs:documentation>
                                  </xs:annotation>
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="item" minOccurs="1" maxOccurs="unbounded">
                                        <xs:complexType>
                                          <xs:attribute name="name" type="xs:string" use="required"/>
                                          <xs:attribute name="note" type="xs:string"/>
                                        </xs:complexType>
                                      </xs:element>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="version"    type="xs:string"  use="required"/>
                              <xs:attribute name="date"       type="xs:string"/>
                              <xs:attribute name="standalone" type="xs:boolean" default="true">
                                <xs:annotation>
                                  <xs:documentation>
                                    Indicator of whether the release is a complete release or an update/patch over a previous version.
                                  </xs:documentation>
                                </xs:annotation>
                              </xs:attribute>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="patches" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="patch" minOccurs="1" maxOccurs="unbounded">
                            <xs:annotation>
                              <xs:documentation>
                                Third-party patch files that can be applied to the corresponding entity.
                              </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="file" minOccurs="1" maxOccurs="unbounded">
                                  <xs:complexType>
                                    <xs:attribute name="path" type="xs:string"       use="required"/>
                                    <xs:attribute name="size" type="xs:unsignedLong" use="required"/>
                                    <xs:attribute name="crc"  type="CrcType"         use="required"/>
                                    <xs:attribute name="md5"  type="Md5Type"         use="required"/>
                                    <xs:attribute name="sha1" type="Sha1Type"        use="required"/>
                                  </xs:complexType>
                                </xs:element>
                              </xs:sequence>
                              <xs:attribute name="name"     type="xs:string" use="required"/>
                              <xs:attribute name="author"   type="xs:string"/>
                              <xs:attribute name="revision" type="xs:string"/>
                              <xs:attribute name="website"  type="xs:string"/>
                              <xs:attribute name="target"   type="xs:string">
                                <xs:annotation>
                                  <xs:documentation>
                                    Hint about which release version this patch targets.
                                  </xs:documentation>
                                </xs:annotation>
                              </xs:attribute>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="identifier"  type="xs:string" use="required">
                    <xs:annotation>
                      <xs:documentation>
                        Unique ID for the entity.
                      </xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                  <xs:attribute name="description" type="xs:string">
                    <xs:annotation>
                      <xs:documentation>
                        Human-readable entity name.
                      </xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                  <xs:attribute name="publisher"   type="xs:string"/>
                  <xs:attribute name="developer"   type="xs:string"/>
                  <xs:attribute name="lastPolled"  type="xs:string">
                    <xs:annotation>
                      <xs:documentation>
                        Date this entity's metadata was last refreshed from an external source.
                      </xs:documentation>
                    </xs:annotation>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
