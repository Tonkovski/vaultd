# Library locator. Copy to vaultd.local.toml (gitignored) and adjust.
# Resolution: a vault named N lives at overrides[N] if set, else root/N.
# Relative paths resolve against the repo root, never the working directory.

# Every vault dir is assumed to rest inside root.
root = "vault"

# Relocated vaults only; keys are vault names (= keeper module names).
[overrides]
# nx_digital = "//nas/vaultd/nx_digital"
